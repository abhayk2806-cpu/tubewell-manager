# Copy to .env (gitignored) and fill in the values for the Supabase project tubewell-hisab.
# Both values are public by design (they ship in the browser bundle); RLS protects the data.
# Never put a service-role / secret key here or in any VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
